<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="llm_thread.LLMChatThreadList" owl="1">
        <div
      class="o_LLMChatThreadList d-flex flex-column flex-grow-1 overflow-auto"
    >
            <t t-if="llmChatView.llmChat.threads.length === 0">
                <div
          class="d-flex flex-column align-items-center justify-content-center flex-grow-1 text-muted p-3"
        >
                    <t t-if="showArchived">
                        <i class="fa fa-archive fa-3x mb-3 text-300" />
                        <span class="fs-6">No archived conversations</span>
                    </t>
                    <t t-else="">
                        <i class="fa fa-comments fa-3x mb-3 text-300" />
                        <span class="fs-6">No chats yet</span>
                    </t>
                </div>
            </t>
            <t t-else="">
                <div class="o_LLMChatThreadList_items d-flex flex-column">
                    <t
            t-foreach="llmChatView.llmChat.orderedThreads"
            t-as="thread"
            t-key="thread.id"
          >
                        <div
              class="o_DiscussSidebarCategoryItem o_llm_thread_list_item btn d-flex align-items-center w-100 px-0 py-2 border-0 rounded-0 fw-normal text-reset bg-100"
              t-att-class="{'o-active bg-200': thread.id === activeThread?.id}"
              t-on-click="() => this._onThreadClick(thread)"
            >
                            <span
                class="o_DiscussSidebarCategoryItem_item o_DiscussSidebarCategoryItem_name ms-3 me-2 text-truncate"
                t-esc="thread.name"
              />
                            <div
                class="o_DiscussSidebarCategoryItem_item flex-grow-1"
              />
                            <!-- Archive: shown when listing active threads -->
                            <button
                t-if="!showArchived"
                class="o_llm_thread_action_btn o_llm_thread_archive_btn btn btn-sm py-0 px-2 me-1 text-muted border-0"
                title="Archive conversation"
                t-on-click.stop.prevent="() => this._onThreadArchive(thread)"
            >
                                <i class="fa fa-archive" />
                            </button>
                            <!-- Unarchive: shown when listing archived threads -->
                            <button
                t-if="showArchived"
                class="o_llm_thread_action_btn o_llm_thread_unarchive_btn btn btn-sm py-0 px-2 me-1 text-muted border-0"
                title="Restore conversation"
                t-on-click.stop.prevent="() => this._onThreadUnarchive(thread)"
            >
                                <i class="fa fa-undo" />
                            </button>
                            <!-- Delete: managers only -->
                            <button
                t-if="isLLMManager"
                class="o_llm_thread_action_btn o_llm_thread_delete_btn btn btn-sm py-0 px-2 me-1 text-muted border-0"
                title="Delete conversation"
                t-on-click.stop.prevent="() => this._onThreadDelete(thread)"
            >
                                <i class="fa fa-trash" />
                            </button>
                        </div>
                    </t>
                </div>
            </t>
        </div>
    </t>
</templates>
